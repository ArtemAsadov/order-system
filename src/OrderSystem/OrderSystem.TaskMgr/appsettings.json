{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      },
      "Https": {
        "Url": "https://*:5001"
      }
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "orderuser",
    "Password": "orderpass",
    "QueueName": "orders"
  },
  "TaskMgr": {
    "WorkerGrpcAddress": "https://*:5001",
    "QueueName": "orders",
    "MaxConcurrentTasks": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
