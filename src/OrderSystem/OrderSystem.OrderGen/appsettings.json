{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      },
      "Https": {
        "Url": "https://*:5001"
      }
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "orderuser",
    "Password": "orderpass",
    "QueueName": "orders"
  },
  "Generator": {
    "DefaultRps": 6000,
    "MaxUsers": 1000,
    "Categories": [
      "electronics",
      "clothing",
      "books",
      "food",
      "sports"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}