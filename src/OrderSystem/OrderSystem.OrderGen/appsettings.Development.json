{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "orderuser",
    "Password": "orderpass",
    "QueueName": "orders"
  },
  "Generator": {
    "DefaultRps": 6000,
    "MaxUsers": 1000,
    "Categories": [
      "electronics",
      "clothing",
      "books",
      "food",
      "sports"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "OrderSystem.OrderGen.Services": "Debug"
    }
  }
}